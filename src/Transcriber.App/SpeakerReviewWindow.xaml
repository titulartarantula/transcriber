<ui:FluentWindow
    x:Class="Transcriber.App.SpeakerReviewWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Transcriber.App"
    Title="Who was speaking?"
    Width="620" Height="560" MinWidth="480" MinHeight="360"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Who was speaking?" ShowMinimize="False" ShowMaximize="False" />

        <TextBlock Grid.Row="1" Margin="24,0,24,12" TextWrapping="Wrap"
                   Text="Name each speaker, or leave a box empty to keep the label. Giving two speakers the same name merges them." />

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,0">
            <ItemsControl x:Name="SpeakerList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:SpeakerRow}">
                        <ui:Card Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="180" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding Speaker, Mode=OneWay}" />
                                        <Run Text="{Binding TalkTime, Mode=OneWay}" FontWeight="Normal"
                                             Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Sample}" TextWrapping="Wrap" FontStyle="Italic" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <TextBlock Text="{Binding Hint}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                </StackPanel>
                                <ui:TextBox Grid.Column="1" VerticalAlignment="Top" PlaceholderText="{Binding Speaker}"
                                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </ui:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="24,14" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Later" MinWidth="90" Margin="0,0,8,0" IsCancel="True"
                           ToolTip="Close without saving; the transcript waits in the list until you name it." />
                <ui:Button Content="Keep labels" MinWidth="110" Margin="0,0,8,0" Click="OnKeep"
                           ToolTip="Save the note with the automatic labels (Remote 1, Remote 2, …)." />
                <ui:Button Content="Save note" MinWidth="110" Appearance="Primary" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
