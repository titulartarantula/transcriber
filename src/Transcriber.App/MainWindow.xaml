<ui:FluentWindow
    x:Class="Transcriber.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:local="clr-namespace:Transcriber.App"
    Title="Transcriber"
    Width="760" Height="680" MinWidth="600" MinHeight="520"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    Closing="OnClosing">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Transcriber">
            <ui:TitleBar.Icon>
                <ui:SymbolIcon Symbol="Mic24" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1" Margin="24,4,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title + settings -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="TitleBox" PlaceholderText="Title for this recording (optional)"
                            Icon="{ui:SymbolIcon TextT24}" />
                <ui:Button Grid.Column="1" Margin="8,0,0,0" Height="36" Icon="{ui:SymbolIcon Settings24}"
                           Content="Settings" Click="OnSettings" />
            </Grid>

            <!-- Sources header -->
            <Grid Grid.Row="1">
                <TextBlock Style="{StaticResource SectionHeader}" Text="AUDIO SOURCES" VerticalAlignment="Center" />
                <ui:Button HorizontalAlignment="Right" Appearance="Transparent" Padding="8,4" Margin="0,0,0,6"
                           Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Refresh" Click="OnRefresh"
                           x:Name="RefreshButton" />
            </Grid>

            <!-- Source list -->
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" x:Name="SourcesScroller">
                <ItemsControl x:Name="SourcesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SourceItem}">
                            <Border Margin="0,0,0,6" Padding="12,10" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Selected}" MinWidth="0" Padding="0"
                                              VerticalAlignment="Center" ToolTip="Record this source" />
                                    <ui:SymbolIcon Grid.Column="1" Symbol="{Binding Icon}" FontSize="20"
                                                   Margin="6,0,12,0" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ProgressBar Maximum="1" Value="{Binding Level, Mode=OneWay}" Height="3"
                                                     Margin="0,6,0,0" MinHeight="3" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Speaker label" FontSize="11" Margin="2,0,0,2"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                        <ui:TextBox Width="130" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}"
                                                    PlaceholderText="{Binding DefaultLabel}" ClearButtonEnabled="False" />
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="4" IsChecked="{Binding Diarize}" VerticalAlignment="Center"
                                                     Content="Split voices"
                                                     ToolTip="Detect several people on this source and label them separately (Remote 1, Remote 2, …)" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Voices -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="2,10,0,0">
                <TextBlock Text="Voices per split source" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ComboBox x:Name="VoicesBox" Width="110" SelectionChanged="OnVoicesChanged"
                          ToolTip="If you know how many people are on the call, saying so gives the most reliable speaker separation." />
                <TextBlock Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"
                           Text="Set it if you know it; Auto estimates." />
            </StackPanel>

            <!-- Controls -->
            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="RecordButton" Appearance="Primary" Height="44" MinWidth="170" FontSize="15"
                           Icon="{ui:SymbolIcon Record24}" Content="Start recording" Click="OnRecord" />
                <TextBlock x:Name="ElapsedText" Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center"
                           FontSize="22" FontFamily="Cascadia Mono, Consolas" Text="00:00:00"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ui:Button x:Name="CancelButton" Content="Cancel" Height="36" Margin="0,0,8,0"
                               Visibility="Collapsed" Click="OnCancel" />
                    <ui:Button x:Name="FileButton" Height="36" Icon="{ui:SymbolIcon DocumentArrowUp20}"
                               Content="Transcribe a file…" Click="OnTranscribeFile" />
                </StackPanel>
            </Grid>

            <!-- Status -->
            <Border x:Name="StatusCard" Grid.Row="5" Margin="0,16,0,0" Padding="14,12" CornerRadius="6"
                    BorderThickness="1" Visibility="Collapsed"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="24" Margin="0,0,12,0" VerticalAlignment="Top">
                        <ui:ProgressRing x:Name="BusyRing" IsIndeterminate="True" Width="20" Height="20" />
                        <ui:SymbolIcon x:Name="StatusIcon" FontSize="20" Visibility="Collapsed" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                        <TextBlock x:Name="StatusDetail" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                        <ui:Button x:Name="RetryButton" Content="Retry" Margin="0,0,8,0" Visibility="Collapsed" Click="OnRetry" />
                        <ui:Button x:Name="OpenButton" Content="Open" Margin="0,0,8,0" Visibility="Collapsed" Click="OnOpen" />
                        <ui:Button x:Name="FolderButton" Icon="{ui:SymbolIcon FolderOpen24}" Content="Show folder"
                                   Visibility="Collapsed" Click="OnShowFolder" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
