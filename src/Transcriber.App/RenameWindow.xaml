<ui:FluentWindow
    x:Class="Transcriber.App.RenameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Rename recording"
    Width="460" SizeToContent="Height" ResizeMode="NoResize"
    WindowStartupLocation="CenterOwner"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    ShowInTaskbar="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Rename recording" ShowMinimize="False" ShowMaximize="False" />

        <StackPanel Grid.Row="1" Margin="24,0,24,16">
            <Label x:Name="TitleLabel" Content="_Title" Target="{Binding ElementName=TitleBox}" Padding="0" Margin="0,0,0,4"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
            <ui:TextBox x:Name="TitleBox" PlaceholderText="Untitled recording"
                        AutomationProperties.Name="Title" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0"
                       Text="The note is named and headed with this when it's saved. The recording's folder and audio keep their names." />
        </StackPanel>

        <Border Grid.Row="2" Padding="24,14" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource LayerFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Cancel" MinWidth="90" Margin="0,0,8,0" IsCancel="True" />
                <ui:Button Content="Rename" MinWidth="110" Appearance="Primary" IsDefault="True" Click="OnSave" />
            </StackPanel>
        </Border>
    </Grid>
</ui:FluentWindow>
