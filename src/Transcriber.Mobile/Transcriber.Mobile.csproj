<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<RootNamespace>Transcriber.Mobile</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<ApplicationTitle>Transcriber</ApplicationTitle>
		<ApplicationId>dev.transcriber.app</ApplicationId>
		<!-- Version comes from Versions.props; versionCode = MAJOR*10000 + MINOR*100 + PATCH so it always increases. -->
		<Version>$(AndroidVersion)</Version>
		<ApplicationDisplayVersion>$(AndroidVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(AndroidVersion)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(AndroidVersion)').Minor), 100)))), $([System.Version]::Parse('$(AndroidVersion)').Build)))</ApplicationVersion>

		<!-- Android 10: foreground-service types and preferred input devices behave consistently from here. -->
		<SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>

		<!-- The diarization native libraries ship for arm64 (phones) and x64 (emulators). -->
		<RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
		<!-- -p:PhoneOnly=true drops the emulator build for a smaller APK. -->
		<RuntimeIdentifiers Condition="'$(PhoneOnly)' == 'true'">android-arm64</RuntimeIdentifiers>
		<AndroidPackageFormat>apk</AndroidPackageFormat>

		<!-- Settings, Whisper responses and MCP messages use reflection-based System.Text.Json; keep it
		     enabled in trimmed release builds. -->
		<JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#2563EB" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#2563EB" BaseSize="128,128" />
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Transcriber.Core\Transcriber.Core.csproj" />
	</ItemGroup>

</Project>
